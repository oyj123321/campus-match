# CampusMatch 环境变量配置
# 复制此文件为 .env，填入真实值。不要把 .env 提交到 Git。
# 完整公测步骤见 docs/beta-launch.md

# === 公测推荐档（熟人 20～50 人）===
# SECRET_KEY=用下面命令生成：python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_DEBUG=false
# ADMIN_SECRET=另生成一串只给你自己
# MAIL_ENABLED=true
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# MAIL_FROM=CampusMatch <hello@campusmatch.com.cn>
# # 或继续用 QQ SMTP：
# # MAIL_PROVIDER=smtp
# # MAIL_SERVER=smtp.qq.com
# # MAIL_PORT=587
# # MAIL_USERNAME=你的QQ号@qq.com
# # MAIL_PASSWORD=SMTP授权码
# # MAIL_FROM=你的QQ号@qq.com
# PUBLIC_URL=https://你的公网地址
# MATCH_MODE=one_to_one
# MATCH_WEEKLY_NEW_LIMIT=1
# MATCH_COOLDOWN_HOURS=12
# REVEAL_REQUIRE_OPT_IN=true
# INSTANT_MATCH_ENABLED=true
# CROSS_SCHOOL_MATCHING_ENABLED=false
# BATCH_SCHEDULER_ENABLED=true
# BATCH_MATCH_DAY=1
# BATCH_MATCH_HOUR=21
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW=3600

# --- 生产安全（上线务必改）---
# SECRET_KEY=请换成足够长的随机字符串
# FLASK_DEBUG=false

# --- 邮件发送（QQ 邮箱）---
# 1. 打开 https://mail.qq.com → 设置 → 账户 → POP3/SMTP 服务 → 开启
# 2. 复制生成的授权码（不是 QQ 密码！）
# 3. 取消下面三行的注释并填入

# MAIL_ENABLED=true
# MAIL_USERNAME=你的QQ号@qq.com
# MAIL_PASSWORD=你的SMTP授权码

# --- 公网地址（serveo 隧道会自动设置）---
# PUBLIC_URL=https://xxx.serveousercontent.com

# --- 其他可选配置 ---
# MATCH_MODE=one_to_one     # 默认：点匹配只配 1 人
# MATCH_MODE=top_n          # 调试：一次返回多人（配合 MATCH_TOP_N）
# MATCH_MODE=batch          # 单次请求走全校匈牙利分配
# MATCH_TOP_N=1
# MATCH_WEEKLY_NEW_LIMIT=1  # 每人每周最多参与 1 次新匹配（发起或被配都算）
# MATCH_MIN_SCORE=0.15      # 内部契合门槛（默认 15%；不对用户展示分数）
# MATCH_COOLDOWN_HOURS=12
# BATCH_SCHEDULER_ENABLED=true
# REVEAL_REQUIRE_OPT_IN=true   # 批量匹配只纳入已预约用户
# INSTANT_MATCH_ENABLED=true   # 冷启动保留「提前揭晓」按钮；正式可 false
# CROSS_SCHOOL_MATCHING_ENABLED=true  # 跨校总闸；用户还需勾选 allow_cross_school
# ADMIN_SECRET=your-secret
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW=3600
# REGISTER_RESEND_SECONDS=60   # 未过期验证码最短重发间隔，连点不换码
# --- 邮件 / 公告（默认：未配对+破冰开启，不限制每日登录）---
# LOGIN_ONCE_PER_DAY=false
# SESSION_REMEMBER_DAYS=7
# MAIL_NO_MATCH_ENABLED=true
# ICEBREAKER_FOLLOWUP_ENABLED=true
# MAIL_INCOMPLETE_NUDGE_ENABLED=true   # 未完成问卷催填；脚本仍需 --send
# INCOMPLETE_NUDGE_COOLDOWN_DAYS=3     # 同一用户 N 天内不重复催填
# SITE_ANNOUNCEMENT=【更新】……   # 覆盖默认橙条；置空则关闭公告条
# # 额度再紧时：LOGIN_ONCE_PER_DAY=true 且 MAIL_NO_MATCH / ICEBREAKER 设 false
