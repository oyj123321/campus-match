# CampusMatch 环境变量配置
# 复制此文件为 .env，填入真实值即可启用邮件

# --- 生产安全（上线务必改）---
# SECRET_KEY=请换成足够长的随机字符串
# FLASK_DEBUG=false

# --- 邮件发送（QQ 邮箱）---
# 1. 打开 https://mail.qq.com → 设置 → 账户 → POP3/SMTP 服务 → 开启
# 2. 复制生成的授权码（不是 QQ 密码！）
# 3. 取消下面三行的注释并填入

# MAIL_ENABLED=true
# MAIL_USERNAME=你的QQ号@qq.com
# MAIL_PASSWORD=你的SMTP授权码

# --- 公网地址（serveo 隧道会自动设置）---
# PUBLIC_URL=https://xxx.serveousercontent.com

# --- 其他可选配置 ---
# MATCH_MODE=batch          # 批量匹配模式（每周二晚9点）
# MATCH_MODE=realtime       # 实时匹配模式（默认）
# MATCH_WEEKLY_NEW_LIMIT=3  # 每用户每周新建匹配上限
# MATCH_COOLDOWN_HOURS=12   # 两次「开始匹配」最短间隔（小时）
# BATCH_SCHEDULER_ENABLED=true  # 进程内自动等到周二晚跑批量
# ADMIN_SECRET=your-secret  # POST /api/admin/batch-run 手动触发
# REGISTER_RATE_LIMIT=5     # 每小时同一邮箱最多发验证码次数
# REGISTER_RATE_WINDOW=3600
